# ── Copy to .env and fill in. Nothing here is required for Phase 0. ──

# LLM provider (used from Phase 2 onward)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6

# HUD weather (real free API wired in Phase 1)
WEATHER_CITY=Sofia

# Frontend → backend wiring (defaults are fine for local docker compose)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Vector memory (used from Phase 4)
QDRANT_URL=http://localhost:6333
