# ── Copy to .env and fill in. Nothing here is required for Phase 0. ──

# LLM provider (used from Phase 2 onward)
# Leave ANTHROPIC_API_KEY blank to run the deterministic OFFLINE MOCK provider
# (the whole orchestrator still works). Set it to use real Claude.
ANTHROPIC_API_KEY=
# Any valid Anthropic model id. Swappable at runtime.
MODEL=claude-sonnet-4-5

# Set DEMO_MODE=1 to replay fake lifecycle events when idle (no task needed).
DEMO_MODE=0

# HUD weather (real free API wired in Phase 1)
WEATHER_CITY=Sofia

# Frontend → backend wiring (defaults are fine for local docker compose)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Vector memory (used from Phase 4)
QDRANT_URL=http://localhost:6333
